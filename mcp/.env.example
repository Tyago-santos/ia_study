# URL do backend StudyHub (o mesmo usado pelo front/mobile)
BACKEND_URL=http://localhost:3000

# Conexão com o Supabase — use a MESMA DATABASE_URL do backend (pooler).
# Nunca use a anon key: a sessão é gravada server-side via pg.
DATABASE_URL=postgresql://usuario:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Token estático que os clientes MCP enviam como Authorization: Bearer.
# Gere com: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# Chave para cifrar (AES-256-GCM) o JWT e a senha guardados no Supabase.
# Gere com: openssl rand -hex 32
MCP_SESSION_SECRET=

# Host público do serviço (sem https://). Proteção contra DNS rebinding.
#Em produção: estudy-ia-mcp.onrender.com
MCP_PUBLIC_HOST=localhost

# Porta local
PORT=3001

# full = todos os módulos (~60 tools) | core = conjunto curado (~25 tools)
MCP_TOOL_PROFILE=full

# Validade da sessão de login no Supabase (horas)
MCP_SESSION_TTL_HOURS=12

NODE_ENV=development
