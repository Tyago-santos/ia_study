# Copie para .env na raiz: `cp .env.example .env`
# Este arquivo alimenta apenas o docker-compose.yml.
# O backend/.env continua sendo usado quando você roda `npm run dev` fora do Docker.

# --- Postgres ---
POSTGRES_USER=estudy
POSTGRES_PASSWORD=estudy
POSTGRES_DB=estudy_ia
# Porta no HOST. Use 5433 se você já tem um Postgres instalado na máquina
# ocupando a 5432 (dentro da rede do compose o banco segue em 5432).
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=3000

# Obrigatórios: o compose falha se estiverem vazios.
# Gere com: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
