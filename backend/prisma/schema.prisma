generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(30)
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects      Subject[]
  resumes       Resume[]
  mindMaps      MindMap[]
  studySessions StudySession[]
  flashcards    Flashcard[]
  quizzes       Quiz[]

  @@map("users")
}

/** Materia da Biblioteca do usuario — pai de assuntos, mapas mentais, flashcards e quizzes. */
model Subject {
  id     String  @id @default(uuid())
  userId String
  name   String  @db.VarChar(100)
  color  String
  icon   String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  topics Topic[]

  mindMaps   MindMap[]
  flashcards Flashcard[]
  quizzes    Quiz[]

  @@map("subjects")
}

/** Assunto dentro de uma materia, com estado de conclusao. */
model Topic {
  id        String  @id @default(uuid())
  subjectId String
  name      String
  completed Boolean @default(false)

  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model Resume {
  id      String @id @default(uuid())
  name    String @db.VarChar(100)
  userId  String
  content String

  user User @relation(fields: [userId], references: [id])

  @@map("resumes")
}

model MindMap {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(100)
  description String?
  userId      String
  subjectId   String

  user    User          @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  nodes   MindMapNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mindmaps")
}

model MindMapNode {
  id        String  @id @default(uuid())
  label     String
  note      String?
  color     String?
  collapsed Boolean @default(false)
  positionX Float?
  positionY Float?

  mindMapId String
  mindMap   MindMap @relation(fields: [mindMapId], references: [id], onDelete: Cascade)

  parentId String?
  parent   MindMapNode?  @relation("MindMapNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MindMapNode[] @relation("MindMapNodeTree")

  @@map("mindmap_nodes")
}

/**
 * Uma sessao de estudo concluida (pomodoro ou avulsa), a base do dashboard e
 * da sequencia de dias. `subjectId`/`subjectName` continuam um rotulo livre
 * (sem FK): mantido assim para nao quebrar sessoes ja gravadas em producao
 * antes da Biblioteca existir no backend.
 */
model StudySession {
  id          String   @id @default(uuid())
  userId      String
  subjectId   String?
  subjectName String?
  duration    Int
  type        String   @default("free")
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("study_sessions")
}

model Flashcard {
  id          String   @id @default(uuid())
  userId      String
  subjectId   String
  front       String
  back        String
  difficulty  String
  nextReview  DateTime @default(now())
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Quiz {
  id          String    @id @default(uuid())
  userId      String
  subjectId   String
  title       String
  questions   Json
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}
