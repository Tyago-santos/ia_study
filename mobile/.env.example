# API used by device builds. For a local backend, replace with:
# iOS Simulator: http://localhost:3002
# Android Emulator: http://10.0.2.2:3002
# Physical device: http://<machine-LAN-IP>:3002
EXPO_PUBLIC_API_URL=https://dev-canil.onrender.com

# A chave do Gemini nao mora mais no app: as chamadas de IA vao para /ai/* no
# backend, que guarda a chave e fala com o provedor por conta do app. Ver
# GEMINI_API_KEY e GEMINI_MODEL em backend/.env.
