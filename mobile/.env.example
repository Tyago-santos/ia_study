# Backend API URL. localhost works from an iOS simulator; on Android emulator
# use http://10.0.2.2:3002, and on a physical device use your machine's LAN IP
# (e.g. http://192.168.0.10:3002) so the phone can reach your dev server.
EXPO_PUBLIC_API_URL=http://localhost:3002

# A chave do Gemini nao mora mais no app: as chamadas de IA vao para /ai/* no
# backend, que guarda a chave e fala com o provedor por conta do app. Ver
# GEMINI_API_KEY e GEMINI_MODEL em backend/.env.
